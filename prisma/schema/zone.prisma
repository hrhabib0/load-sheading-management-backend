model Zone {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  substations         Substation[]
  operatorAssignments OperatorZoneAssignment[]
  managerAssignment   ZoneManagerAssignment?

  @@map("zones")
}
