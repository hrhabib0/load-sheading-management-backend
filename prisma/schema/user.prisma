model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  phone    String?
  role     UserRole @default(CUSTOMER)
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile               CustomerProfile?
  operatorAssignments           OperatorZoneAssignment[]
  managerAssignments            ZoneManagerAssignment?
  createdIncidents              OutageIncident[]         @relation("IncidentCreator")
  verifiedIncidents             OutageIncident[]         @relation("IncidentVerifier")
  technicianTasks               WorkTask[]               @relation("TechnicianTasks")
  createdTasks                  WorkTask[]               @relation("TaskCreator")
  createdPlannedOutages         PlannedOutage[]          @relation("PlannedOutageCreator")
  approvedPlannedOutages        PlannedOutage[]          @relation("PlannedOutageApprover")
  createdLoadSheddingSchedules  LoadSheddingSchedule[]   @relation("LoadSheddingCreator")
  approvedLoadSheddingSchedules LoadSheddingSchedule[]   @relation("LoadSheddingApprover")
  notifications                 Notification[]
  auditLogs                     AuditLog[]

  @@map("users")
}
