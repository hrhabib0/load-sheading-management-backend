model Feeder {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  substationId String
  substation   Substation @relation(fields: [substationId], references: [id])

  areas                 Area[]
  outageIncidents       OutageIncident[]
  plannedOutages        PlannedOutageFeeder[]
  loadSheddingSchedules LoadSheddingFeeder[]

  @@index([substationId])
  @@map("feeders")
}
