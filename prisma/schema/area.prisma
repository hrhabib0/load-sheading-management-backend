model Area {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feederId String
  feeder   Feeder @relation(fields: [feederId], references: [id])

  customerProfiles CustomerProfile[]

  @@index([feederId])
  @@map("areas")
}
